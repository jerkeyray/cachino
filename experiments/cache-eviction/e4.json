  "stop_rules": [
    "Stop at the first ID parity mismatch and keep the mismatching request and response bodies.",
    "Stop if a reset returns success false or a non-200 status.",
    "Stop if prompt_tokens_details or per-request metrics are absent; record them as unavailable, never as zero.",
    "No retries. A transport failure ends the run with the failed step recorded.",
    "Other check failures are recorded and the sequence continues, so one run shows every control's outcome."
  ],
  "check_definitions": {
    "parity": "returned prompt_token_ids equal local IDs element by element, and usage.prompt_tokens equals their count when reported",
    "cached_zero": "usage.prompt_tokens_details.cached_tokens is reported and equals 0",
    "predicted": "cached_tokens and created_cache_tokens equal the free-queue predictor's values for this step, computed at build time from the stated block count and block size. A mismatch is a recorded failure, not a stop"
